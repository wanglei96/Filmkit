<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 相册页（用户报的第 5/6 点）：要显示"所有照片"就得读整个 MediaStore。
         API 33 起读写媒体拆成细分权限，更早版本只有 READ_EXTERNAL_STORAGE ⇒ 按
         maxSdkVersion 分级声明。被拒不影响可用性：相册页降级为只读本应用的
         Pictures/FilmKit（scoped storage 下自己的文件免权限可见）。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- largeHeap（2026-10-01，v0.10.86）：连拍时 MFNR 每张在飞要持 4 帧
         direct buffer（4×25MB=100MB），而 Android 的 ByteBuffer.allocateDirect 走
         VMRuntime.trackExternalAllocation —— **外部内存照样计入 ART 的 OOM 额度**。
         在飞 2 张（200MB）+ 成片回传的 50MB byte[] 撞上默认 256MB growth limit →
         OOM 发生在 JNI SetByteArrayRegion 里 → pending exception → ART abort
         （SIGABRT in FilmStill，真机 2026-10-01 11:22:59 实测，tombstone_07）。
         这里把额度抬到设备上限；native 侧的 ExceptionCheck 防护见 Bridge.cpp。 -->
    <application
        android:name=".FilmKitApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FilmKit"
        android:largeHeap="true"
        android:supportsRtl="true">

        <!-- configChanges：窗口方向由相机页按**设备物理姿态**主动设置（见 CameraScreen 的
             requestedOrientation）。必须自行处理方向变化，否则每次横竖切换都会重建 Activity
             → 相机 session 被拆掉重开（黑屏/卡顿）。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
